APP_ENV=dev
PORT=8000
DATABASE_PATH=./data/visiongpt.db

# --- Gemini API (pick one auth method) ---
# Option A: API key (Gemini Developer API)
GEMINI_API_KEY=
# Option B: Vertex AI (uses OAuth 2.0 / service account)
VERTEX_AI=false
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# Path to service account JSON key (instead of gcloud auth)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# --- Google Maps Geocoding (optional, improves location accuracy) ---
# Enable Geocoding API in Google Cloud Console, then create an API key
# GEOCODING_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_MB=10
STORE_RAW_IMAGES=false
ENABLE_WHATSAPP_NOTIFY=false
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=
# e.g. 919876543210 or a provider-specific chat id
AUTHORITY_WHATSAPP_TO=
